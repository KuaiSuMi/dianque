{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dq",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "ADMIN_USER_ID": "06dcc519-daf0-49af-8d01-3c4ca5c2032c" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "Dianque" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Dianque"] }],
  "dev": { "port": 3000, "ip": "0.0.0.0" }
}
